{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [],
  "printWidth": 80,
  "embeddedLanguageFormatting": "auto",
  "experimentalSortImports": {
    "groups": [
      [
        "side-effect"
      ],
      [
        "builtin"
      ],
      [
        "external",
        "external-type"
      ],
      [
        "internal",
        "internal-type"
      ],
      [
        "parent",
        "parent-type"
      ],
      [
        "sibling",
        "sibling-type"
      ],
      [
        "index",
        "index-type"
      ]
    ]
  },
  "experimentalSortPackageJson": true,
